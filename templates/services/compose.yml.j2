# サーバーで動かす全サービスの定義（ADR 0004）。各サービスのデータ・秘密情報は ./<サービス名>/ 配下に置く
services:
  bifrost:
    image: maximhq/bifrost:{{ bifrost_version }}
    restart: unless-stopped
    # Bifrost は秘密情報を環境変数でしか受け取らないため、ファイルから読んで環境変数へ入れてから
    # 本来のエントリポイントを起動する（ADR 0002）。docker inspect に秘密情報を出さないため
    entrypoint:
      - /bin/sh
      - -c
      - |
        BIFROST_ENCRYPTION_KEY="$$(cat /run/secrets/bifrost_encryption_key)"
        BIFROST_SETUP_TOKEN="$$(cat /run/secrets/bifrost_setup_token)"
        export BIFROST_ENCRYPTION_KEY BIFROST_SETUP_TOKEN
        exec /app/docker-entrypoint.sh
    # 管理画面は mini-pc 自身にだけ公開し、Tailscale Serve で tailnet 内へ出す（ADR 0003）
    ports:
      - "127.0.0.1:{{ bifrost_admin_port }}:8080"
    volumes:
      - ./bifrost/data:/app/data
    secrets:
      - bifrost_encryption_key
      - bifrost_setup_token
    # AI を使うアプリはこのネットワークに参加し、http://bifrost:8080 で呼ぶ
    networks:
      - ai

  trading-studio:
    image: ghcr.io/canpok1/trading-studio:latest
    pull_policy: always
    restart: unless-stopped
    environment:
      TZ: Asia/Tokyo
    # mini-pc 自身にだけ公開し、Tailscale Serve で tailnet 内へ出す（trading-studio の ADR 0003・0004）
    ports:
      - "127.0.0.1:3000:3000"
    volumes:
      - ./trading-studio/data:/app/data
    # 採点・アドバイスで Bifrost を呼ぶ。接続先はアプリの設定画面で http://bifrost:8080/openai を指定する
    networks:
      - default
      - ai

  plant-diary:
    image: ghcr.io/canpok1/plant-diary/server:latest
    pull_policy: always
    restart: unless-stopped
    # Gemini の API キーは環境変数でしか受け取らないため、ファイルから読んで環境変数へ入れてから起動する。
    # docker inspect に API キーを出さないため（Bifrost と同じ）
    entrypoint:
      - /bin/sh
      - -c
      - |
        GEMINI_API_KEY="$$(cat /run/secrets/gemini_api_key)"
        export GEMINI_API_KEY
        exec ./plant-diary
    # mini-pc 自身にだけ公開し、Tailscale Serve で tailnet 内へ出す。撮影の cron は localhost で呼ぶ。
    # アカウント作成 API に認証が無いため、LAN やインターネットへは直接出さない
    ports:
      - "127.0.0.1:8080:8080"
    volumes:
      - ./plant-diary/data:/app/data
    secrets:
      - gemini_api_key

secrets:
  bifrost_encryption_key:
    file: ./bifrost/secrets/bifrost_encryption_key
  bifrost_setup_token:
    file: ./bifrost/secrets/bifrost_setup_token
  gemini_api_key:
    file: ./plant-diary/secrets/gemini_api_key

networks:
  ai:
    external: true
