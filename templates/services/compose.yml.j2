# サーバーで動かす全サービスの定義（ADR 0004）。各サービスのデータ・秘密情報は ./<サービス名>/ 配下に置く
services:
  bifrost:
    image: maximhq/bifrost:{{ bifrost_version }}
    restart: unless-stopped
    # Bifrost は秘密情報を環境変数でしか受け取らないため、ファイルから読んで環境変数へ入れてから
    # 本来のエントリポイントを起動する（ADR 0002）。docker inspect に秘密情報を出さないため
    entrypoint:
      - /bin/sh
      - -c
      - |
        BIFROST_ENCRYPTION_KEY="$$(cat /run/secrets/bifrost_encryption_key)"
        BIFROST_SETUP_TOKEN="$$(cat /run/secrets/bifrost_setup_token)"
        export BIFROST_ENCRYPTION_KEY BIFROST_SETUP_TOKEN
        exec /app/docker-entrypoint.sh
    # 管理画面は mini-pc 自身にだけ公開し、Tailscale Serve で tailnet 内へ出す（ADR 0003）
    ports:
      - "127.0.0.1:{{ bifrost_admin_port }}:8080"
    volumes:
      - ./bifrost/data:/app/data
    secrets:
      - bifrost_encryption_key
      - bifrost_setup_token
    # AI を使うアプリはこのネットワークに参加し、http://bifrost:8080 で呼ぶ
    networks:
      - ai

  trading-studio:
    image: ghcr.io/canpok1/trading-studio:latest
    pull_policy: always
    restart: unless-stopped
    environment:
      TZ: Asia/Tokyo
    # mini-pc 自身にだけ公開し、Tailscale Serve で tailnet 内へ出す（trading-studio の ADR 0003・0004）
    ports:
      - "127.0.0.1:3000:3000"
    volumes:
      - ./trading-studio/data:/app/data

secrets:
  bifrost_encryption_key:
    file: ./bifrost/secrets/bifrost_encryption_key
  bifrost_setup_token:
    file: ./bifrost/secrets/bifrost_setup_token

networks:
  ai:
    external: true
