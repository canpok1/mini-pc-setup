[Unit]
Description=Apply mini-pc-setup main to this host with ansible-pull
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# playbook はログインユーザーの HOME と名前から ~/services などのパスを決めるため、root では動かさない
User={{ auto_deploy_user }}
Environment=PATH={{ auto_deploy_home }}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
Environment=ANSIBLE_NOCOLOR=1
# root だけが読めるファイルを、このサービスにだけ一時的に見せる
LoadCredential=vault-password:{{ auto_deploy_vault_password_file }}
ExecStart={{ auto_deploy_home }}/.local/bin/ansible-pull \
  --url {{ auto_deploy_repo_url }} \
  --checkout main \
  --directory {{ auto_deploy_checkout_dir }} \
  --inventory localhost, \
  --only-if-changed \
  --clean \
  --vault-password-file ${CREDENTIALS_DIRECTORY}/vault-password \
  playbook.yml
TimeoutStartSec=1h
Nice=10
