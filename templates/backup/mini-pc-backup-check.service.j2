[Unit]
Description=Verify the restic repository on the NAS
RequiresMountsFor={{ backup_mount_point }}

[Service]
Type=oneshot
EnvironmentFile=/etc/mini-pc-backup/restic.env
# 毎日のバックアップで忘れた世代のデータを NAS から消す
ExecStart=/usr/bin/restic prune
# 毎回全データを読むと時間がかかるため、一部だけ読んで壊れていないか確かめる
ExecStart=/usr/bin/restic check --read-data-subset={{ backup_check_subset }}
Nice=10
IOSchedulingClass=idle
# automount の idle-timeout だけでは外れないことがあったため、終わったら外す。
# 他方のサービスが使用中なら外せないが、そのときは失敗を無視する
ExecStopPost=-/usr/bin/umount {{ backup_mount_point }}
